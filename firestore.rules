rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== Staff collection ====================
    match /staff/{staffId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.authUid;
      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== Admins collection ====================
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== leaveApplications collection ====================
    match /leaveApplications/{leaveId} {
      // Staff can create a leave application only for themselves
      allow create: if request.auth != null
        && request.resource.data.officerId == request.auth.uid
        && request.resource.data.status == "pending"
        && !request.resource.data.keys().hasAny(["reviewedBy", "reviewedByName", "reviewedAt"]);

      // Staff can read only their own leave applications
      allow read: if request.auth != null && (
        resource.data.officerId == request.auth.uid
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      // Only admins can update leave applications
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (
          // Allow updating status, reviewedBy, reviewedByName, reviewedAt, adminComment
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "reviewedBy", "reviewedByName", "reviewedAt", "adminComment"])
        )
        // Ensure status can only change to approved or rejected (not back to pending)
        && request.resource.data.status in ["approved", "rejected"];

      // Staff cannot delete; only admins can delete
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== incidentReports collection ====================
    match /incidentReports/{reportId} {
      // Staff can create an incident report only for themselves
      allow create: if request.auth != null
        && request.resource.data.officerId == request.auth.uid
        && request.resource.data.status == "pending"
        && !request.resource.data.keys().hasAny(["attendedAt"]);

      // Staff can read only their own reports; admins can read all
      allow read: if request.auth != null && (
        resource.data.officerId == request.auth.uid
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      // Only admins can update reports (mark attended)
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "attendedAt"])
        && request.resource.data.status in ["pending", "attended"];

      // Only admins can clear reports
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==================== Default deny ====================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
